    function loadRasp(url, data, raspEl, kabEl = null, hideLoader = false) {
        $.ajax({
            type: "POST",
            url: url,
            data: data,
            success: function (msg) {
                if($(msg).find('div#kabOptions').length){
                    kabEl.html($(msg).find('div#kabOptions').html());
                    setTimeout(function() {kabEl.trigger('refresh');  }, 1);
                    tmpEl = $(msg);
                    tmpEl.find('div#kabOptions').remove();
                    msg = $(tmpEl).html(function(idx, str){return str})
                }
                raspEl.html(msg);
                if (hideLoader){
                    $('.preload').hide();
                }
            }
        });
    }

    function loadGroupRasp(group_name, paramUrl = ''){
        $('.rasp-list-group .rasp-item-inner').html('');
        if(group_name && group_name.length){
            $('.rasp-zag-group').html('Группа ' + group_name);
        }
        if(!paramUrl.length){
            paramUrl = getParamsFromEl();
        }
        loadRasp("/ajax/icalendar.php", "group_name=" + group_name, $('.icalendar_link'));
        loadRasp("/ajax/rasp.php", paramUrl, $('.rasp-list-group'), $('select[name="kab_stud"]'), true);
    }

    function loadTeacherRasp(teacher_name, paramUrl = ''){
        $('.rasp-list-teacher .rasp-item-inner').html('');
        if(!paramUrl.length){
            paramUrl = getParamsFromEl();
        }
        loadRasp("/ajax/icalendar.php", "teacher_name=" + teacher_name, $('.icalendar_link'));
        loadRasp("/ajax/rasp_teacher.php", paramUrl, $('.rasp-list-teacher'), $('select[name="kab_prep"]'), true);
    }

    function getParamsFromUrl() {
        return window.location.search.replace('?','').split('&').reduce(
            function(p,e){
                var a = e.split('=');
                p[ decodeURIComponent(a[0])] = decodeURIComponent(a[1]);
                return p;
            },
            {}
        );
    }

    function getParamsFromEl() {
        paramUrl = '';
        let tmpParamsObj = {};
        let tmpParamsArr = [];
        if($('.stud-r').is(':visible')){
            if($('select[name="group_name"]').val()){
                tmpParamsObj.group_name = $('select[name="group_name"]').val();
            }
            if($('select[name="kab_stud"]').val() && $('select[name="kab_stud"]').val() != '-1'){
                tmpParamsObj.kab_stud = $('select[name="kab_stud"]').val();
            }
            if($('input[name="exam_stud"]').is(':checked')){
                tmpParamsObj.exam_stud = true;
            }
        }else if($('.prep-r').is(':visible')){
            if($('select[name="teacher_search"]').val()){
                // paramUrl = 'teacher_name=' + $('select[name="teacher_search"]').val();
                tmpParamsObj.teacher_name = $('select[name="teacher_search"]').val();
            }
            if($('select[name="kab_prep"]').val() && $('select[name="kab_prep"]').val() != '-1'){
                // paramUrl += '&kab_prep=' + $('select[name="kab_prep"]').val();
                tmpParamsObj.kab_prep = $('select[name="kab_prep"]').val();
            }
            if($('input[name="exam_prep"]').is(':checked')){
                // paramUrl += '&exam_prep=true';
                tmpParamsObj.exam_prep = true;
            }
        }
        Object.entries(tmpParamsObj).forEach(el=>tmpParamsArr.push(el.join('=')));
        if(tmpParamsArr.length){
            paramUrl = tmpParamsArr.join('&');
        }

        console.log(paramUrl);
        return paramUrl;
    }

    function setStyle(){
        if($('.stud-r').is(':visible')){
            if($('input[name="exam_stud"]').is(':checked')){

$(document).ready(function(){
	//Слайдер на главной
	if($('.new-main-slider').length){
		var owl = $('.new-main-slider');
		owl.owlCarousel({
			loop: true,
			nav: false,
			dots: true,
			touchDrag: true,
			pullDrag: true,
			autoplay: false,
			autoWidth: false,
			margin: 0,
			items: 1,
			autoplayTimeout : 10000,
			autoplaySpeed: 600,
			animateSpeed: 1600,
			navSpeed: 600,
		});
	}

	//Слайдер событий
	//Создаём элементы управления
	if($('.sob-slider').length){
		$('.sob-slider-wrap').append('<div class="sob-dots"></div>');
		if($(window).width() > 1024) {
			sobItems = $('.sob-slider .sob-item').length - 2;
		} else {			
			sobItems = $('.sob-slider .sob-item').length;
		}
		var step;
		for (step = 0; step < sobItems; step++) {
			if(step == 0) {
				$('.sob-dots').append('<div class="sob-dot active"></div>');
			} else {
				$('.sob-dots').append('<div class="sob-dot"></div>');
			}
			$('.sob-slider .sob-item:first-child').addClass('now-sob')
		}
	}

	//Клик по доту
	$(document).on('click', '.sob-dot', function (e) {
		thisIndex = $(this).index();
		changesob(thisIndex);
	});

	//Колёсико мыши
	/*
	$('.sob-slider').mousewheel(function(event) {
		event.preventDefault();	
		thisIndex = parseInt($('.now-sob').index() + (event.deltaY * -1));
		changesob(thisIndex);
	});
	*/
	
	//Автоматическое листание
	function autoSob(){
		sobInterval = setInterval(function(){
			thisIndex = $('.now-sob').index() + 1;
			changesob(thisIndex);
		}, 7000)
	}
	autoSob();

	//Смена слайда
	var activelide = true;
	function changesob(target){
		if(activelide == true){
			lengthe = $('.sob-slider .sob-item').length;
			now = $('.now-sob').index();	

			if($(window).width() > 1024) {
				var korect = 3;
			} else {
				var korect = 1;
			}
			if(target > lengthe - korect) {
				target = 0;
			}
			if(target < 0) {
				target = lengthe - korect;
			}
			$('.sob-dot:nth-child('+(target + 1)+')').addClass('active').siblings('.sob-dot').removeClass('active');
			$('.sob-slider .sob-item:nth-child('+(target + 1)+')').addClass('now-sob').siblings('.sob-item').removeClass('now-sob');
			stepSize = parseFloat($('.now-sob').css('height')) + parseFloat($('.now-sob').css('margin-bottom'));	
			//$('.sob-slider .sob-item:first-child').css('margin-top', (stepSize * target * -1));
			$('.sob-slider-scroll').css('top', (stepSize * target * -1));
			activelide = false;
			setTimeout(function(){
				activelide = true;
			},200);
			clearInterval(sobInterval);
			autoSob();
		}
	}
	
	//Запет на перетскивание
	$(".sob-item").on("dragstart", function(event) { event.preventDefault(); });

	/*Листание*/
	var tekpos = 0
	var tekpos2 = 0	
	
	$(".sob-slider").bind('touchstart', function(e){
		tekpos = e.targetTouches[0].clientX
	})
	$(".sob-slider").bind('touchmove', function(e){
		tekpos2 = e.targetTouches[0].clientX
	})
	$('.sob-slider').bind('touchend', function(e){		
		if(tekpos > tekpos2){
			if((tekpos - tekpos2) > 50){
				thisIndex = parseInt($('.now-sob').index() + 1);
				changesob(thisIndex);
			}
		} else {
			if((tekpos2 - tekpos) > 50){
				thisIndex = parseInt($('.now-sob').index() - 1);
				changesob(thisIndex);
			}
		}
	})
	
	
	//Слайдер партнёров
	if($('.partners-slider').length){
		var owl3 = $('.partners-slider');
		owl3.owlCarousel({
			loop:true,
			nav:true,
			dots: false,
			touchDrag: true,
			pullDrag: true,
			autoplay: true,
			autoWidth: false,
			margin:20,
			items:4,
			autoplayTimeout : 10000,
			autoplaySpeed: 600,
			animateSpeed: 1600,
			navSpeed: 600,			
			navText : ['',''],
			responsive:{
				0:{
					margin: 0,
					items:1
				},
				1024:{
					margin: 20,
					items:4
				}
			}
		});
	}

	//Слайдер новостей
	if($(window).width() <= 1024 && $('.main-news-list').length) {
		$('.main-news-list').addClass('owl-carousel');
		setTimeout(function(){
			var owl4 = $('.main-news-list');
			owl4.owlCarousel({
				loop:true,
				nav:false,
				dots: false,
				touchDrag: true,
				pullDrag: true,
				autoplay: false,
				autoWidth: false,
				margin:0,
				items:1,
				autoplayTimeout : 5000,
				autoplaySpeed: 600,
				animateSpeed: 1600,
				navSpeed: 600
			});				
		},1);
	}
	
	$(document).on('click', function (e) {		
		if(!$(event.target).hasClass('btn-login') && !$(event.target).closest('#lkdrop')[0]) $('#lkdrop').hide();
	});
	
	//Клик по несуществующим лк
	$(document).on('click', '.lkabi, .lkstu', function (e) {
		e.preventDefault();
		alert('Раздел находится в разработке');
	});
	
});
